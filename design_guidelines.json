{
  "design_system": {
    "identity": {
      "name": "CultureShield AI",
      "archetype": "Swiss & High-Contrast",
      "vibe": "Professional, Authoritative, Data-Driven, Secure",
      "target_audience": "SMB HR, IT Managers, Security Officers"
    },
    "typography": {
      "font_family": {
        "headings": "Plus Jakarta Sans, sans-serif",
        "body": "Inter, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-4xl md:text-5xl font-bold tracking-tight",
        "h2": "text-3xl font-semibold tracking-tight",
        "h3": "text-2xl font-semibold tracking-tight",
        "body_lg": "text-lg leading-relaxed",
        "body_base": "text-base leading-relaxed",
        "caption": "text-sm text-muted-foreground"
      },
      "weights": {
        "heading": "font-bold",
        "subheading": "font-semibold",
        "body": "font-normal"
      }
    },
    "colors": {
      "palette": {
        "primary": "#1F3A5F",
        "secondary": "#00A8E8",
        "success": "#2ECC71",
        "warning": "#F39C12",
        "risk": "#E74C3C",
        "background": "#F8FAFC",
        "surface": "#FFFFFF",
        "text_primary": "#0F172A",
        "text_secondary": "#64748B"
      },
      "usage": {
        "primary_action": "bg-[#1F3A5F] text-white hover:bg-[#162a45]",
        "secondary_action": "bg-[#00A8E8] text-white hover:bg-[#008dc2]",
        "risk_high": "bg-red-50 text-[#E74C3C] border-red-200",
        "risk_medium": "bg-orange-50 text-[#F39C12] border-orange-200",
        "risk_low": "bg-green-50 text-[#2ECC71] border-green-200"
      }
    },
    "layout": {
      "grid_system": {
        "dashboard": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6",
        "landing_hero": "grid grid-cols-1 lg:grid-cols-12 gap-12 items-center",
        "features": "grid grid-cols-1 md:grid-cols-3 gap-8"
      },
      "spacing": {
        "section_padding": "py-20 md:py-32",
        "container_padding": "px-6 md:px-12",
        "card_padding": "p-6"
      },
      "container": "max-w-7xl mx-auto"
    },
    "components": {
      "buttons": {
        "style": "rounded-md font-medium transition-all duration-200",
        "primary": "bg-[#1F3A5F] text-white shadow-sm hover:shadow-md hover:-translate-y-0.5",
        "outline": "border-2 border-[#1F3A5F] text-[#1F3A5F] hover:bg-[#1F3A5F] hover:text-white"
      },
      "cards": {
        "dashboard": "bg-white rounded-lg border border-slate-200 shadow-sm hover:shadow-md transition-shadow",
        "feature": "bg-slate-50 rounded-xl p-8 border border-slate-100 hover:border-[#00A8E8]/30 transition-colors"
      },
      "inputs": {
        "style": "rounded-md border-slate-300 focus:ring-2 focus:ring-[#00A8E8] focus:border-transparent"
      }
    },
    "visual_enhancers": {
      "shadows": {
        "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
        "dropdown": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
      },
      "borders": {
        "default": "1px solid #E2E8F0",
        "active": "1px solid #00A8E8"
      },
      "glassmorphism": "bg-white/80 backdrop-blur-md border border-white/20 shadow-lg"
    },
    "motion": {
      "page_transition": "initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.3 }}",
      "hover_scale": "whileHover={{ scale: 1.02 }} whileTap={{ scale: 0.98 }}",
      "stagger_children": "variants={{ hidden: { opacity: 0 }, show: { opacity: 1, transition: { staggerChildren: 0.1 } } }}"
    }
  },
  "assets": {
    "images": {
      "hero_bg": "https://images.unsplash.com/photo-1734971702116-3f61289df2c8?crop=entropy&cs=srgb&fm=jpg&q=85",
      "team_meeting": "https://images.unsplash.com/photo-1770777843445-2a1621b1201d?crop=entropy&cs=srgb&fm=jpg&q=85",
      "security_abstract": "https://images.unsplash.com/photo-1759661881353-5b9cc55e1cf4?crop=entropy&cs=srgb&fm=jpg&q=85",
      "logo_url": "https://customer-assets.emergentagent.com/job_shieldaudit/artifacts/x4x6u2ps_The%20CultureShield%20Group.jpeg"
    },
    "icons": {
      "library": "lucide-react",
      "preferred": ["Shield", "Lock", "Users", "BarChart3", "AlertTriangle", "CheckCircle", "FileText", "Settings"]
    }
  },
  "pages": {
    "landing": {
      "sections": ["Hero", "Features", "HowItWorks", "Testimonials", "CTA"],
      "hero_style": "Split layout: Left text, Right 3D/Abstract visual or Dashboard Mockup"
    },
    "dashboard": {
      "layout": "Sidebar navigation + Main Content Area",
      "widgets": ["RiskScoreCard", "DepartmentRiskTable", "HumanRiskHeatmap", "RecentActivityFeed"]
    },
    "report": {
      "style": "A4 aspect ratio container, print-friendly CSS, high-contrast charts"
    }
  },
  "instructions_to_main_agent": {
    "general": [
      "Use 'Plus Jakarta Sans' for all headings to give a modern SaaS feel.",
      "Ensure all charts (Recharts) use the defined color palette (Risk=Red, Success=Green).",
      "Implement the 'Bento Grid' layout for the dashboard widgets.",
      "Use the 'Glassmorphism' style for the login/signup forms overlaying the abstract background.",
      "Ensure all interactive elements have 'data-testid' attributes."
    ],
    "specific_components": [
      "Create a 'RiskHeatmap' component using a grid of colored cells.",
      "Customize Shadcn 'Card' to match the 'cards.dashboard' style defined above.",
      "Use 'Sonner' for all toast notifications.",
      "Ensure the PDF report generation uses a print-specific stylesheet or library that respects the corporate theme."
    ]
  },
  "universal_guidelines": [
    "Do not use generic gradients. Use solid colors or subtle noise textures.",
    "Ensure 2-3x more spacing than typical designs (e.g., p-8 instead of p-4).",
    "Add micro-interactions to all buttons and cards (hover lift, scale).",
    "Never use 'Inter' for headings. Use 'Plus Jakarta Sans'.",
    "Always use 'lucide-react' for icons."
  ]
}